let epgSearchResults=[]
let epgSearchPage=1
const EPG_SEARCH_PAGE_SIZE=5
let epgSourcePage=1
const EPG_SOURCE_PAGE_SIZE=5

function epgSearchTotalPages(){return Math.ceil(epgSearchResults.length/EPG_SEARCH_PAGE_SIZE)||1}

function renderEpgSearch(){
 const tbody=$('epgSearchBody')
 const total=epgSearchResults.length
 const totalPages=Math.ceil(total/EPG_SEARCH_PAGE_SIZE)||1
 if(epgSearchPage>totalPages)epgSearchPage=totalPages
 const start=(epgSearchPage-1)*EPG_SEARCH_PAGE_SIZE
 const page=epgSearchResults.slice(start,start+EPG_SEARCH_PAGE_SIZE)
 if(!total){tbody.innerHTML='<tr><td colspan="4" class="empty">未找到频道</td></tr>';$('epgSearchPagination').innerHTML='';return}
 tbody.innerHTML=page.map(c=>{
  const srcUrl=c.source_url||''
  const srcRemark=getEpgSourceRemark(srcUrl)
  return `<tr>
   <td style="font-size:11px;word-break:break-all">${escapeHtml(srcRemark)}</td>
   <td><span title="${escapeHtml(c.name)||escapeHtml(c.id)}">${(escapeHtml(c.name)||escapeHtml(c.id)).substring(0,10)}</span></td>
   <td style="text-align:center"><span class="badge badge-success">${c.rule||'auto'}</span></td>
   <td style="text-align:center"><button class="btn btn-sm btn-primary" onclick="addFromSearch('${escapeHtml(c.name)}','${escapeHtml(c.id)}','${escapeHtml(c.rule||'auto')}','${escapeHtml(srcUrl)}')">➕ 添加</button></td>
  </tr>`
 }).join('')
 const pag=$('epgSearchPagination')
pag.innerHTML=`<span style="font-size:11px;color:var(--text-secondary);margin-right:8px">共${total}条</span>
  <button onclick="epgSearchPage=1;renderEpgSearch()" ${epgSearchPage<=1?'disabled':''}>«</button>
  <button onclick="epgSearchPage=Math.max(1,epgSearchPage-1);renderEpgSearch()" ${epgSearchPage<=1?'disabled':''}>‹</button>
  <span style="padding:0 8px;font-size:12px">${epgSearchPage}/${epgSearchTotalPages()}</span>
  <button onclick="epgSearchPage=Math.min(epgSearchTotalPages(),epgSearchPage+1);renderEpgSearch()" ${epgSearchPage>=epgSearchTotalPages()?'disabled':''}>›</button>
  <button onclick="epgSearchPage=epgSearchTotalPages();renderEpgSearch()" ${epgSearchPage>=epgSearchTotalPages()?'disabled':''}>»</button>`
}

