// ==================== 列宽拖拽 ====================
document.addEventListener('DOMContentLoaded',function(){
 const savedPageSize=sessionStorage.getItem('pageSize');if(savedPageSize){var ps=$('pageSize');if(ps){ps.value=savedPageSize}}
 // 列宽拖拽 - 仅当前列和右侧相邻列参与变化
 function applyColWidths(table,idx,cw,nw,sw,nsw){
  const MIN=50
  const total=sw+nsw  // 两列总宽不变
  cw=Math.max(MIN,Math.min(cw,total-MIN))
  nw=total-cw
  table.querySelectorAll('tr').forEach(tr=>{
   const cur=tr.children[idx]
   if(cur){cur.style.width=cw+'px';cur.style.minWidth=cw+'px';cur.style.maxWidth=cw+'px'}
   const nxt=tr.children[idx+1]
   if(nxt){nxt.style.width=nw+'px';nxt.style.minWidth=nw+'px';nxt.style.maxWidth=nw+'px'}
  })
 }
 document.querySelectorAll('th .resize-handle').forEach(handle=>{
  const th=handle.parentElement
  handle.addEventListener('mousedown',function(e){
   e.preventDefault()
   const startX=e.clientX
   const table=th.closest('table')
   if(!table)return
   const idx=Array.from(th.parentElement.children).indexOf(th)
   const nextTh=th.parentElement.children[idx+1]
   if(!nextTh)return
   const startW=th.offsetWidth
   const nextStartW=nextTh.offsetWidth
   th.classList.add('resize-active')
   function onMouseMove(ev){
    const delta=ev.clientX-startX
    const cw=startW+delta
    const nw=nextStartW-delta
    applyColWidths(table,idx,cw,nw,startW,nextStartW)
   }
   function onMouseUp(){
    th.classList.remove('resize-active')
    document.removeEventListener('mousemove',onMouseMove)
    document.removeEventListener('mouseup',onMouseUp)
    saveColumnWidths()
   }
   document.addEventListener('mousemove',onMouseMove)
   document.addEventListener('mouseup',onMouseUp)
  })
 })
})

async function saveColumnWidths(){
 const widths={}
 document.querySelectorAll('table').forEach(tbl=>{
  const tblId=tbl.id||'t'+(Array.from(document.querySelectorAll('table')).indexOf(tbl)+1)
  tbl.querySelectorAll('th').forEach(th=>{
   const w=th.style.width||th.offsetWidth
   const text=tblId+'_'+th.textContent.trim().substring(0,20)
   widths[text]=parseInt(w)
  })
 })
 try{
  await fetch('/api/column-widths',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(widths)})
 }catch(e){}
}

async function loadColumnWidths(){
 try{
  const r=await fetch('/api/column-widths');const d=await r.json()
  if(!d||!Object.keys(d).length)return
  document.querySelectorAll('table').forEach(tbl=>{
   const tblId=tbl.id||'t'+(Array.from(document.querySelectorAll('table')).indexOf(tbl)+1)
   tbl.querySelectorAll('th').forEach(th=>{
    const text=tblId+'_'+th.textContent.trim().substring(0,20)
    const w=d[text]
   if(w>20){
    th.style.width=w+'px'
    th.style.minWidth=w+'px'
    th.style.maxWidth=w+'px'
    const table=th.closest('table')
    if(!table)return
    const idx=Array.from(th.parentElement.children).indexOf(th)
    table.querySelectorAll('tr').forEach(tr=>{
     const cell=tr.children[idx]
     if(cell&&cell!==th){
      cell.style.width=w+'px'
      cell.style.minWidth=w+'px'
      cell.style.maxWidth=w+'px'
     }
    })
   }
  })
  })
 }catch(e){}
}

