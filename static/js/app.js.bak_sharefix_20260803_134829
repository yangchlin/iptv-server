// 判断某 tvg-logo 是否为“本服务器某图标的直链”
// 匹配规则：URL 路径末尾为 /api/icons/file/{文件名} 且该文件名在台标列表里（前缀可变）
function m3uMatchIconName(logo){
 if(!logo) return ''
 const m=String(logo).match(/\/api\/icons\/file\/([^/?#]+)$/)
 if(!m) return ''
 const name=decodeURIComponent(m[1])
 if(_m3uIconFiles.some(f=>f.name===name)) return name
 return ''
}

// 直链前缀（当前站点 origin + 图标相对路径）
function m3uIconFullUrl(relUrl){
 return location.protocol+'//'+location.host+relUrl
}

// 判断是否是内网 IP（192.168.x / 10.x / 172.16-31.x / 127.x）
function m3uIsLanHost(host){
 const ip=(host||'').split(':')[0]
 if(!ip) return false
 const p=ip.split('.')
 if(p.length!==4) return false
 const a=parseInt(p[0],10),b=parseInt(p[1],10)
 if(a===10) return true
 if(a===127) return true
 if(a===192&&b===168) return true
 if(a===172&&b>=16&&b<=31) return true
 return false
}

