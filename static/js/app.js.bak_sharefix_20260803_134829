async function loadChannels(){
 const r=await fetch('/api/channels');const d=await r.json()
 channels=d.channels||[]
 renderChannels()
}
async function renderChannels(){
 const tbody=$('channelBody');const empty=$('channelEmpty')
 const pageSize=parseInt($('pageSize').value)
 const total=channels.length
 const totalPages=Math.ceil(total/pageSize)||1
 if(currentPage>totalPages)currentPage=totalPages
 const start=(currentPage-1)*pageSize
 const page=channels.slice(start,start+pageSize)

 if(total===0){tbody.innerHTML='';empty.style.display='block';$('channelPagination').innerHTML='';$('channelPaginationTop').innerHTML='';const nr=$('channelNewRow');if(nr)nr.style.display='';return}
 empty.style.display='none'

 tbody.innerHTML=page.map((ch,i)=>{
  const idx=start+i
  const enabled=ch.enabled!==false
  return `<tr>
   <td style="cursor:grab" draggable="true"
    ondragstart="dragChannel(event,${idx})"
    ondrop="dropChannel(event,${idx})"
    ondragover="event.preventDefault()">☰</td>
   <td><input value="${escapeHtml(ch.name)}" style="border:none;background:transparent" onchange="updateChannelField(${idx},'name',this.value)"></td>
   <td><input value="${escapeHtml(ch.tvg_id||'')}" style="width:60px;border:none;background:transparent" onchange="updateChannelField(${idx},'tvg_id',this.value)"></td>
   <td><input value="${escapeHtml(ch.url)}" style="border:none;background:transparent;width:100%" onchange="updateChannelUrl(${idx},this.value)"></td>
   <td style="text-align:center"><span class="badge ${enabled?'badge-success':'badge-danger'}">${enabled?'启用':'禁用'}</span></td>
   <td style="text-align:center">
    <button class="btn btn-sm" onclick="toggleChannel(${idx})">${enabled?'⛔':'✅'}</button>
    <button class="btn btn-sm btn-danger" onclick="deleteChannel(${idx})">✕</button>
   </td>
  </tr>`
 }).join('')

 // 显示新行（仅在最后一页）
 const newRow=$('channelNewRow')
 if(newRow) newRow.style.display=(currentPage>=totalPages)?'':'none'
 // 显示下一个自动递增的 TVG-ID
 const tvgDisplay=$('newChTvgIdDisplay')
 if(tvgDisplay){
  const maxId=channels.reduce((m,ch)=>{const id=parseInt(ch.tvg_id);return id>m?id:m},0)
  tvgDisplay.textContent='→'+String(maxId+1)
 }
 const pag=$('channelPagination')
 const pagTop=$('channelPaginationTop')
 const html=`<button onclick="goPage(1)" ${currentPage<=1?'disabled':''}>«</button>
  <button onclick="goPage(${currentPage-1})" ${currentPage<=1?'disabled':''}>‹</button>
  <span style="padding:0 8px;font-size:12px">${currentPage}/${totalPages} (共${total}条)</span>
  <button onclick="goPage(${currentPage+1})" ${currentPage>=totalPages?'disabled':''}>›</button>
  <button onclick="goPage(${totalPages})" ${currentPage>=totalPages?'disabled':''}>»</button>`
 pag.innerHTML=html
 if(pagTop) pagTop.innerHTML=html
}

function goPage(p){
 currentPage=p
 renderChannels()
}

async function updateChannelField(idx,field,val){
 if(idx>=channels.length)return
 channels[idx][field]=val
 await fetch(`/api/channels/${idx}`,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({[field]:val})})
 // 同步到EPG管理列表
 if(field==='name'||field==='tvg_id'){
  const lid=channels[idx].logic_id
  if(lid){
   const ei=epgChList.findIndex(ch=>ch.logic_id===lid)
   if(ei>=0&&epgChList[ei].source_type==='channel'){
    epgChList[ei][field]=val
    await fetch('/api/epg-channels/'+ei,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({[field]:val})})
   }
  }
 }
 // 刷新 M3U 选项
 if(typeof _m3uOptions!=='undefined'){
  try{
   const r=await fetch('/api/m3u/channel-options?_='+Date.now());const d=await r.json()
   if(d.options) _m3uOptions=d.options
  }catch(e){}
  if($('m3uEditor')&&$('m3uEditor').style.display==='block') renderM3uTable(currentM3uEntries,_m3uOptions)
 }
}

async function updateChannelUrl(idx,val){
 const cleaned=val.replace(/_\d{8}\.json/g,'_{date}.json')
 if(cleaned!==val) showToast('已自动替换日期为 {date} 占位符','success')
 channels[idx].url=cleaned
 await fetch(`/api/channels/${idx}`,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({url:cleaned})})
 renderChannels()
}

async function toggleChannel(idx){
 if(idx>=channels.length)return
 const ch=channels[idx]
 ch.enabled=ch.enabled===false?true:false
 await fetch(`/api/channels/${idx}`,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({enabled:ch.enabled})})
 renderChannels()
}

async function deleteChannel(idx){
 if(!confirm('确定删除该频道？'))return
 await fetch(`/api/channels/${idx}`,{method:'DELETE'})
 channels.splice(idx,1)
 renderChannels()
 await syncAllAfterChange()
}

async function clearAllChannels(){
 if(!confirm('确定清空所有频道？此操作不可撤销！'))return
 await fetch('/api/channels/clear',{method:'POST'})
 channels=[]
 renderChannels()
 await syncAllAfterChange()
}

let dragIdx=null
function dragChannel(e,i){dragIdx=i}
async function dropChannel(e,i){
 if(dragIdx===null||dragIdx===i)return
 const arr=channels
 const [moved]=arr.splice(dragIdx,1)
 arr.splice(i,0,moved)
 channels=arr
 const indices=channels.map((_,i)=>i)
 await fetch('/api/channels/reorder',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({indices})})
 renderChannels()
 dragIdx=null
}

async function autoAddChannel(){
 const name=$('newChName').value.trim()
 const url=$('newChUrl').value.trim()
 if(!name||!url)return
 const cleaned=url.replace(/_\d{8}\.json/g,'_{date}.json')
 $('newChUrl').value=cleaned
 const r=await fetch('/api/channels',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name,url:cleaned})})
 const d=await r.json()
 if(d.success){
  showToast('已添加: '+name,'success')
  $('newChName').value=''
  $('newChUrl').value=''
 
  const ps=parseInt($('pageSize').value)
  currentPage=Math.ceil((channels.length+1)/ps)
  loadChannels()
  await syncAllAfterChange()
 }
}

