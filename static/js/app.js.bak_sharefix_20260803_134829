   <td><input value="${escapeHtml(ch.tvg_id||'')}" style="width:60px;border:none;background:transparent" onchange="updateEpgChField(${i},'tvg_id',this.value)"></td>
   <td><input value="${escapeHtml(ch.tvg_name||ch.name||'')}" style="width:100%;border:none;background:transparent" onchange="updateEpgChField(${i},'tvg_name',this.value)"></td>
   <td style="font-size:11px">${(function(){const st=ch.source_type||'';if(st==='extract'){const remark=ch.source_remark||'';const en=ch.extract_name||'';if(en&&en!==ch.name){return remark+' ('+en+')'}return remark}return ch.source_remark||'自建json'})()}</td>
   <td style="text-align:center"><span class="badge ${ch.enabled!==false?'badge-success':'badge-danger'}">${ch.enabled!==false?'启用':'禁用'}</span></td>
