async function refreshEpgChannels(){
 // 按 logic_id 同步 EPG 管理列表
 const [r1,r2,r3] = await Promise.all([
  fetch('/api/channels').then(r=>r.json()),
  fetch('/api/epg/extracts').then(r=>r.json()),
  fetch('/api/epg/sources').then(r=>r.json())
 ])
 epgSources=r3.sources||[]
 const chList = r1.channels||[]
 const extList = r2.extracts||[]
 const logicIds = new Set()
 const sources = []
 for(const ch of chList){
  if(!ch.logic_id) ch.logic_id='sync_chan_'+ch.name
  logicIds.add(ch.logic_id)
  sources.push({logic_id:ch.logic_id, name:ch.name, tvg_id:ch.tvg_id||'', tvg_name:ch.name, source_type:'channel', source_remark:'自建json'})
 }
 for(const ext of extList){
  if(!ext.logic_id) ext.logic_id='sync_ext_'+ext.name
  logicIds.add(ext.logic_id)
  if(!sources.find(s=>s.logic_id===ext.logic_id)){
   const remark=getEpgSourceRemark(ext.source_url)||ext.source||''
   sources.push({logic_id:ext.logic_id, name:ext.name, tvg_id:ext.tvg_id||'', tvg_name:ext.name, source_type:'extract', source_remark:remark, extract_name:ext.name})
  }
 }
 await fetch('/api/epg-channels/sync-all',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({logic_ids:[...logicIds], sources})})
 showToast('同步完成','success')
 const rd=await fetch('/api/epg-channels');const dd=await rd.json()
 epgChList=dd.channels||[]
 renderEpgChannels()
}
