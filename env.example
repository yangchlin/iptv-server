# ============================================================================
# iptv-server 环境变量（复制为 .env 后按需修改；不建 .env 也能直接启动）
#   cp .env.example .env
# ============================================================================

# ---- 访问端口 ----
# 宿主机端口，容器内固定是 80。冲突就改这里，例如 8080
WEB_PORT=5673

# ---- 时区 ----
TZ=Asia/Shanghai

# ---- 登录凭据 ----
# 注意：首次启动后凭据会写入 <DATA_ROOT>/config/auth.json，
#       之后再改这里不会再生效（请用页面「账户密码」修改，或删掉 auth.json 重建）
AUTH_USERNAME=666
AUTH_PASSWORD=666

# ---- 数据目录 ----
# 默认 ./data（相对 docker-compose.yml 所在目录），任何机器都能直接用。
# 群晖示例：DATA_ROOT=/volume1/docker/iptv/data
# 飞牛示例：DATA_ROOT=/vol1/1000/Docker/IPTV
DATA_ROOT=/volume2/docker/IPTV

# “共享目录”：生成 epg.xml 时额外备份一份到这里
# 默认放在数据目录里面；也可以指向群晖上另一个共享文件夹
SHARE_DIR=/volume2/ST

# 外部工具目录：仪表盘「电脑播放」下载的 IPTV.exe 放这里（默认 <DATA_ROOT>/tools）
# 换播放器版本时直接替换文件，重启不用重建镜像
TOOLS_DIR=/volume2/docker/IPTV/tools

# ---- 容器名（多实例时改掉）----
CONTAINER_NAME=itv-EPGserver

# ---- 构建镜像源（默认国内；海外改成官方源）----
APT_MIRROR=mirrors.aliyun.com
# APT_MIRROR=deb.debian.org
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn
# PIP_INDEX_URL=https://pypi.org/simple
# PIP_TRUSTED_HOST=

# ---- DNS（外网 EPG 解析不了时再改）----
DNS1=223.5.5.5
DNS2=119.29.29.29
